# Copy to .env and edit. Settings can also be set as environment variables (they win over .env).
# Relative paths are resolved against the folder you start the app or pipeline from, so start from the repo root,
# or use absolute paths (recommended for real data).

# --- Environment ---
# "development" serves the interactive API docs at /docs; anything else hides them
ENV=development

# --- Pipeline identity ---
# Name recorded in logs and reports
PIPELINE_NAME=ionome-lcms

# --- Storage backend ---
# "local" = files on disk. "s3" is a placeholder and does not work yet.
STORAGE_BACKEND=local

# Local storage paths (used when STORAGE_BACKEND=local)
# Folder that CONTAINS one sub-folder per study: <LCMS_RAW_DATA_DIR>/<study_id>/ holds the raw files and the sample sheet
LCMS_RAW_DATA_DIR=raw_data
# Results go to <LCMS_RESULTS_DIR>/<study_id>/ (plots, tables, QC report, checkpoints)
LCMS_RESULTS_DIR=results
# Folder holding the reference spectral libraries (.msp / .mgf)
LCMS_REFERENCE_LIBRARY_DIR=reference_libraries
# Where each study's registered config is stored as <study_id>.yaml
YAML_DIR=state/yaml

# S3 (only used when STORAGE_BACKEND=s3)
AWS_S3_BUCKET=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Database ---
# Name and file of the SQLite database (no server needed; created on first start)
LCMS_DB_NAME=ionome
LCMS_DB_PATH=state/ionome.db
# Declared in the settings but not read by any code yet, so it has no effect
LCMS_DB_ECHO=false

# --- API ---
# 127.0.0.1 = this machine only. Any other address requires API_TOKEN (the API can write files and start runs).
API_HOST=127.0.0.1
# Password for HTTP Basic authentication (any user name); required when API_HOST is not 127.0.0.1
# API_TOKEN=
# Host names the server answers to (protects against DNS rebinding)
# API_ALLOWED_HOSTS=localhost,127.0.0.1
API_PORT=8000
# true = restart the server when code changes (development only)
API_RELOAD=false
API_LOG_INFO=info

# --- Pipeline ---
# Number of studies that can run at the same time (each in its own process)
LCMS_MAX_WORKERS=4
# Declared in the settings but not read by any code yet, so it has no effect. To recompute stages use --force
# (scripts/register_study.py) or delete <LCMS_RESULTS_DIR>/<study_id>/checkpoints.
LCMS_CACHE_ENABLED=true

# --- Logging ---
# Declared in the settings but not read by any code yet (also API_LOG_INFO above), so they have no effect
LOG_LEVEL=info
LOG_FORMAT=json
